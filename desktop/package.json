{
  "name": "aura-shell",
  "private": true,
  "version": "0.19.33",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && /opt/homebrew/bin/node ./node_modules/vite/bin/vite.js build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:build": "bun run app:build:arm64 && bun run app:build:intel",
    "app:build:arm64": "bun run tauri build --target aarch64-apple-darwin && bun run app:bundle-mcp:arm64 && bun run app:bundle-cli:arm64 && bash scripts/sign-notarize.sh arm64",
    "app:build:intel": "bun run tauri build --target x86_64-apple-darwin && bun run app:bundle-mcp:intel && bun run app:bundle-cli:intel && bash scripts/sign-notarize.sh intel",
    "app:build:arm64:fast": "bun run tauri build --target aarch64-apple-darwin && bun run app:bundle-mcp:arm64 && bun run app:bundle-cli:arm64 && SKIP_NOTARIZE=1 bash scripts/sign-notarize.sh arm64",
    "app:build:intel:fast": "bun run tauri build --target x86_64-apple-darwin && bun run app:bundle-mcp:intel && bun run app:bundle-cli:intel && SKIP_NOTARIZE=1 bash scripts/sign-notarize.sh intel",
    "app:bundle-mcp:arm64": "cp ../target/aarch64-apple-darwin/release/aura-shell-mcp ../target/aarch64-apple-darwin/release/bundle/macos/Aura.app/Contents/MacOS/aura-shell-mcp",
    "app:bundle-mcp:intel": "cp ../target/x86_64-apple-darwin/release/aura-shell-mcp ../target/x86_64-apple-darwin/release/bundle/macos/Aura.app/Contents/MacOS/aura-shell-mcp",
    "app:build-cli:arm64": "cargo build --release --manifest-path ../aura-cli/Cargo.toml --target aarch64-apple-darwin",
    "app:build-cli:intel": "cargo build --release --manifest-path ../aura-cli/Cargo.toml --target x86_64-apple-darwin",
    "app:bundle-cli:arm64": "bun run app:build-cli:arm64 && cp ../aura-cli/target/aarch64-apple-darwin/release/aura ../target/aarch64-apple-darwin/release/bundle/macos/Aura.app/Contents/MacOS/aura",
    "app:bundle-cli:intel": "bun run app:build-cli:intel && cp ../aura-cli/target/x86_64-apple-darwin/release/aura ../target/x86_64-apple-darwin/release/bundle/macos/Aura.app/Contents/MacOS/aura",
    "icons:generate": "node scripts/generate-file-icons.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
