# Aura Runner — runtime config. Copy to `runner.env` and fill in.
#   cp aura-runner/runner.env.example aura-runner/runner.env
# Pass with:  docker run --env-file aura-runner/runner.env aura-runner
#
# `runner.env` holds secrets — keep it OUT of git. Nothing here is baked into
# the image; it is all injected at run time.

# ---- repo the crew runs on (required) ---------------------------------------
# Git URL to clone and drive. Include a credential so the runner can pull AND
# push back the agent's commits (a fine-grained PAT or deploy key with push).
#   https://<user>:<token>@github.com/you/your-repo.git
AURA_RUNNER_REPO=

# Branch to track. Empty = the remote's default branch.
AURA_RUNNER_BRANCH=

# ---- the agent the loop dispatches ------------------------------------------
# One of: claude | codex | gemini | cursor. Must be installed in the image and
# have its key present (see secrets below). Default: claude.
AURA_RUNNER_AGENT=claude

# Agent API key — REQUIRED for real work; the loop cannot dispatch without it.
# This is the AURA-89 secret: only put a key on a box you control and trust.
ANTHROPIC_API_KEY=

# ---- loop behaviour ---------------------------------------------------------
# Crash-recovery lease window (seconds): a dead runner's claimed node is
# reclaimed into the ready set after this elapses. Default 1800.
AURA_RUNNER_LEASE_SECS=1800

# Optional acceptance gate run after each node; non-zero fails (and, with the
# loop's rollback, reverts) the node. e.g. "cargo check" or "bun run tsc".
AURA_RUNNER_VERIFY=

# Idle wait between drain cycles, seconds. Default 30.
AURA_RUNNER_POLL_SECS=30

# Push the agent's commits back to origin each cycle. 1 = push, 0 = local only.
AURA_RUNNER_PUSH=1

# ---- commit identity for the runner's own pushes ----------------------------
AURA_RUNNER_GIT_NAME=Aura Runner
AURA_RUNNER_GIT_EMAIL=runner@auravcs.com

# Where the repo is checked out inside the container. Default /workspace.
AURA_RUNNER_WORKDIR=/workspace
