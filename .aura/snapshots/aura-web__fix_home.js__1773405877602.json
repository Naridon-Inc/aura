{"file_path":"aura-web/fix_home.js","content":"import fs from 'fs';\n\nconst content = fs.readFileSync('src/pages/Home.tsx', 'utf-8');\n\n// Find the start and end of Section 3\nconst startIndex = content.indexOf('{/* BUILT FOR PRODUCTION: SCROLL SPY REDESIGN */}');\nconst endIndex = content.indexOf('{/* MOBILE FALLBACK (Same Typography) */}');\n\nif (startIndex === -1 || endIndex === -1) {\n  console.log(\"Could not find section boundaries\");\n  process.exit(1);\n}\n\nconst newSection = `      {/* BUILT FOR PRODUCTION: ROCK SOLID SCROLL SPY */}\n      <section className=\"bg-[#050505] hidden lg:block border-y border-white/10 relative z-20\">\n        <div className=\"flex w-full relative\">\n          \n          {/* LEFT: Scrolling Content */}\n          <div className=\"w-1/2 flex flex-col border-r border-white/5 relative z-10 pb-[30vh]\">\n            \n            {/* Header Block */}\n            <div className=\"h-screen flex flex-col justify-center px-8 md:px-16 lg:px-24\">\n              <SectionReveal>\n                <h2 className=\"text-[52px] md:text-[72px] lg:text-[90px] font-serif leading-[0.9] tracking-tight text-[#F5F5F3] mb-8\">\n                  Built for prod.<br/>\n                  <span className=\"italic text-[#888]\">Not for demos.</span>\n                </h2>\n                <p className=\"text-[18px] md:text-[22px] text-[#AAA] leading-[1.6] font-sans font-medium max-w-xl\">\n                  Aura enforces the mathematical invariants of your repository when autonomous agents are typing at 1,000 WPM.\n                </p>\n              </SectionReveal>\n            </div>\n            \n            {/* Features List */}\n            <div className=\"flex flex-col\">\n              {[\n                {\n                  id: 'rewind',\n                  num: '01',\n                  title: 'Semantic Time Machine',\n                  subtitle: 'Surgical Rewind & Amnesia.',\n                  desc: 'When an AI hallucinates, git revert causes massive conflicts. Aura allows you to surgically swap AST nodes and injects an Amnesia Protocol to wipe the bad code from the AI\\\\'s chat context.'\n                },\n                {\n                  id: 'identity',\n                  num: '02',\n                  title: 'Physics Engine',\n                  subtitle: 'Immutable Identity.',\n                  desc: 'Structural Skeleton Hashing prevents the Git renaming death spiral. The logic identity persists mathematically regardless of name.'\n                },\n                {\n                  id: 'gsd',\n                  num: '03',\n                  title: 'Wave Execution',\n                  subtitle: 'Isolated Orchestration.',\n                  desc: 'Prevent LLM context rot. Aura execute spins up fresh, isolated contexts sequentially to guarantee hallucination-free generation.'\n                },\n                {\n                  id: 'gatekeeper',\n                  num: '04',\n                  title: 'The Gatekeeper',\n                  subtitle: 'Deep AST Traversal.',\n                  desc: 'Aura mathematically proves whether forbidden logic exists via deep tree-sitter traversal, projecting the blast radius instantly.'\n                },\n                {\n                  id: 'vault',\n                  num: '05',\n                  title: 'Sovereign Vault',\n                  subtitle: 'Zero-Trust Workspaces.',\n                  desc: 'Dynamically strips proprietary algorithms from contractor workspaces, replacing them with type-safe logic stubs.'\n                },\n              ].map((item) => (\n                <FeatureItem \n                  key={item.id} \n                  item={item} \n                  activeFeature={activeFeature} \n                  setActiveFeature={setActiveFeature} \n                />\n              ))}\n            </div>\n          </div>\n\n          {/* RIGHT: Sticky Visuals Panel */}\n          <div className=\"w-1/2 relative\">\n            <div className=\"sticky top-0 h-screen w-full flex items-center justify-center bg-[#0A0A0A] bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.02)_0%,transparent_80%)]\">\n               \n               {activeFeature === 'rewind' && (\n                 <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} className=\"w-full max-w-lg bg-black border border-white/10 p-1 flex flex-col shadow-[0_0_80px_rgba(255,255,255,0.03)]\">\n                    <div className=\"bg-white/5 px-6 py-4 border-b border-white/5 flex items-center justify-between\">\n                       <span className=\"font-mono text-[10px] uppercase tracking-[0.2em] text-white/40\">AST Swap Protocol</span>\n                       <span className=\"text-[10px] font-mono text-emerald-500/60 uppercase\">Verified</span>\n                    </div>\n                    <div className=\"p-8 font-mono text-[13px] text-white/20 space-y-4\">\n                       <div className=\"flex items-center gap-4 opacity-30\"><span>42</span><span>Node: init()</span></div>\n                       <div className=\"flex items-center gap-4 py-3 bg-white/5 border border-white/10 text-white px-4\">\n                         <span className=\"text-white/40\">43</span>\n                         <span className=\"flex-1\">Node: process_token()</span>\n                         <span className=\"bg-white text-black px-1.5 py-0.5 text-[9px] font-bold tracking-widest\">RESTORED</span>\n                       </div>\n                       <div className=\"flex items-center gap-4 opacity-30\"><span>44</span><span>Node: cleanup()</span></div>\n                    </div>\n                 </motion.div>\n               )}\n\n               {activeFeature === 'identity' && (\n                 <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} className=\"w-full max-w-lg bg-black border border-white/10 p-1 flex flex-col shadow-[0_0_80px_rgba(255,255,255,0.03)]\">\n                    <div className=\"bg-white/5 px-6 py-4 border-b border-white/5 flex items-center justify-between\">\n                       <span className=\"font-mono text-[10px] uppercase tracking-[0.2em] text-white/40\">Logic Identity Match</span>\n                       <span className=\"text-[10px] font-mono text-emerald-500/60\">Confidence: 0.98</span>\n                    </div>\n                    <div className=\"p-12 flex flex-col items-center gap-8\">\n                       <div className=\"text-white/20 font-mono text-[12px] line-through\">function old_auth()</div>\n                       <div className=\"w-px h-8 bg-white/10\" />\n                       <div className=\"bg-white/10 border border-white/20 p-4 text-white font-mono text-[12px] flex items-center justify-between w-full\">\n                          <span>function secure_verify()</span> \n                          <span className=\"text-emerald-400 ml-4 bg-emerald-500/10 px-2 py-0.5\">[HASH MATCH]</span>\n                       </div>\n                    </div>\n                 </motion.div>\n               )}\n\n               {activeFeature === 'gsd' && (\n                 <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} className=\"w-full max-w-lg bg-black border border-white/10 p-1 flex flex-col shadow-[0_0_80px_rgba(255,255,255,0.03)]\">\n                    <div className=\"bg-white/5 px-6 py-4 border-b border-white/5 flex items-center justify-between\">\n                       <span className=\"font-mono text-[10px] uppercase tracking-[0.2em] text-white/40\">Isolated Context Flow</span>\n                    </div>\n                    <div className=\"p-8 font-mono text-[13px] space-y-4\">\n                       <div className=\"text-white/60\">$ aura execute --step 1</div>\n                       <div className=\"space-y-3 pt-4\">\n                          <div className=\"flex justify-between items-center\">\n                            <span>[1/3] DB Setup</span> \n                            <span className=\"text-emerald-500 font-bold bg-emerald-500/10 px-2 py-0.5\">DONE</span>\n                          </div>\n                          <div className=\"flex justify-between items-center text-white/60\">\n                            <span>[2/3] API Layer</span> \n                            <span className=\"text-white animate-pulse bg-white/10 px-2 py-0.5\">RUNNING</span>\n                          </div>\n                       </div>\n                       <div className=\"mt-6 pt-4 border-t border-white/5 text-[10px] text-white/30 uppercase tracking-widest text-center\">\n                         Context Purged Between Cycles\n                       </div>\n                    </div>\n                 </motion.div>\n               )}\n\n               {activeFeature === 'gatekeeper' && (\n                 <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} className=\"w-full max-w-lg bg-black border border-red-500/20 p-1 flex flex-col shadow-[0_0_80px_rgba(255,0,0,0.05)]\">\n                    <div className=\"bg-red-500/10 px-6 py-4 border-b border-red-500/20 flex items-center justify-between\">\n                       <span className=\"font-mono text-[10px] uppercase tracking-[0.2em] text-red-500/80\">Gatekeeper Violation</span>\n                    </div>\n                    <div className=\"p-8 text-center space-y-6\">\n                       <div className=\"text-red-500 font-bold font-serif text-2xl\">Merge Blocked</div>\n                       <div className=\"bg-red-500/5 border border-red-500/20 p-4 text-left\">\n                         <p className=\"text-[12px] font-mono text-red-200/60 leading-relaxed\">\n                            AST Path: auth_service.rs {'->'} login() {'->'}<br/>call_expression: <span className=\"text-white font-bold\">print!(secret_key)</span>\n                         </p>\n                       </div>\n                    </div>\n                 </motion.div>\n               )}\n\n               {activeFeature === 'vault' && (\n                 <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} className=\"w-full max-w-lg bg-black border border-white/10 p-1 flex flex-col shadow-[0_0_80px_rgba(255,255,255,0.03)]\">\n                    <div className=\"bg-white/5 px-6 py-4 border-b border-white/5 flex items-center justify-between\">\n                       <span className=\"font-mono text-[10px] uppercase tracking-[0.2em] text-white/40\">Zero-Trust Protocol</span>\n                    </div>\n                    <div className=\"p-10 space-y-8 flex flex-col items-center\">\n                       <div className=\"w-full bg-white/5 border border-white/10 p-4 text-center font-mono text-[11px] blur-[2px] opacity-50\">PROPRIETARY_LOGIC_HIDDEN</div>\n                       <div className=\"h-10 w-px bg-white/20 relative\"><span className=\"absolute left-4 top-1/2 -translate-y-1/2 text-[10px] font-mono text-white/40\">AES-256</span></div>\n                       <div className=\"w-full bg-[#111] border border-white/5 p-4 text-center font-mono text-[11px] text-white/20 break-all h-20 overflow-hidden relative\">\n                         <div className=\"absolute inset-0 bg-gradient-to-b from-transparent to-[#111]\" />\n                         U2FsdGVkX1+m...M0f8vK9<br/>x8bY3...9jZ\n                       </div>\n                    </div>\n                 </motion.div>\n               )}\n\n            </div>\n          </div>\n        </div>\n      </section>\n\n`;\n\nconst updatedContent = content.substring(0, startIndex) + newSection + content.substring(endIndex);\nfs.writeFileSync('src/pages/Home.tsx', updatedContent, 'utf-8');\nconsole.log(\"Replaced successfully!\");\n","timestamp":1773405877602,"trigger":"pre_deletion_guard","agent_id":"Aura Deletion Guard"}