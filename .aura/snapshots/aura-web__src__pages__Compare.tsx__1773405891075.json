{"file_path":"aura-web/src/pages/Compare.tsx","content":"import { useEffect, useState } from 'react';\nimport Navbar from '../components/Navbar';\nimport Footer from '../components/Footer';\nimport SectionReveal from '../components/SectionReveal';\nimport WarpedDataWall, { generateDataWall } from '../components/WarpedDataWall';\nimport { GitBranch, Layers, History, Hammer, Check, Minus } from 'lucide-react';\n\nexport default function Compare() {\n  const [dataRows, setDataRows] = useState<string[]>([]);\n\n  useEffect(() => {\n    setDataRows(generateDataWall(100)); \n  }, []);\n\n  return (\n    <div className=\"min-h-screen bg-[#050505] text-[#F5F5F3] font-sans overflow-x-hidden\">\n      <Navbar />\n      \n      <main className=\"pt-32 pb-32\">\n        {/* Header Section */}\n        <section className=\"px-8 md:px-16 lg:px-24 w-full pt-16 mb-24 relative overflow-hidden\">\n          <div className=\"absolute inset-0 z-0 opacity-20 pointer-events-none\">\n            {dataRows.length > 0 && <WarpedDataWall rows={dataRows} />}\n          </div>\n          <div className=\"relative z-10 w-full flex flex-col gap-10\">\n            <SectionReveal>\n              <div className=\"text-[11px] font-mono uppercase tracking-[0.2em] text-white/50 mb-8\">\n                The AI-Native Tool Landscape\n              </div>\n              \n              <h1 className=\"text-[40px] md:text-[72px] lg:text-[90px] font-serif leading-[0.95] tracking-tight text-[#F5F5F3] mb-12\">\n                The unvarnished truth<br/>\n                <span className=\"italic text-[#888]\">about AI developer tools.</span>\n              </h1>\n\n              <div className=\"border-t border-white/10 pt-12\">\n                <p className=\"text-[20px] md:text-[24px] text-[#AAA] leading-[1.6] font-medium max-w-4xl mb-6\">\n                  Not all tools serve the same purpose. We rigorously benchmarked the top AI coding tools. Here is the definitive breakdown of when to use a Project Manager, when to use a Bulldozer, and when you need a Semantic Scalpel.\n                </p>\n                <p className=\"text-[16px] md:text-[18px] text-[#34d399] leading-[1.6] font-mono max-w-4xl\">\n                  Crucial Note: Aura is a meta-layer, not a Git replacement. You keep your existing Git workflow, your existing repository, and your commits. Aura wraps Git to provide AST-level logic tracking.\n                </p>\n              </div>\n            </SectionReveal>\n          </div>\n        </section>\n\n        {/* The Fundamental Difference */}\n        <section className=\"px-8 md:px-16 lg:px-24 w-full mb-32\">\n          <SectionReveal>\n            <h2 className=\"text-[32px] md:text-[48px] font-serif mb-16 text-white\">\n              The AI Dev Stack, Compared.\n            </h2>\n          </SectionReveal>\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\">\n            {/* Standard Git */}\n            <SectionReveal>\n              <div className=\"bg-[#0A0A0A] border border-white/10 p-8 h-full flex flex-col gap-6\">\n                <div className=\"flex items-center gap-4 border-b border-white/10 pb-6\">\n                  <div className=\"w-12 h-12 bg-[#111] rounded-full flex items-center justify-center border border-white/5 shrink-0\">\n                    <GitBranch size={20} className=\"text-white/60\" />\n                  </div>\n                  <div>\n                    <h3 className=\"text-xl font-bold text-white\">Legacy Git</h3>\n                    <div className=\"text-[11px] font-mono text-white/40 uppercase tracking-widest mt-1\">Text-State Ledger</div>\n                  </div>\n                </div>\n                \n                <p className=\"text-[14px] text-white/70 leading-[1.8]\">\n                  Tracks character changes. When an AI rewrites 4,000 lines, Git presents a chaotic wall of red and green with no context.\n                </p>\n                <div className=\"bg-[#111] border border-white/5 p-4 font-mono text-[12px] text-white/60 mt-auto\">\n                  <span className=\"text-red-400 font-bold\">Flaw:</span> Reverting AI code causes catastrophic merge conflicts.\n                </div>\n              </div>\n            </SectionReveal>\n\n            {/* GSD */}\n            <SectionReveal>\n              <div className=\"bg-[#0A0A0A] border border-white/10 p-8 h-full flex flex-col gap-6\">\n                <div className=\"flex items-center gap-4 border-b border-white/10 pb-6\">\n                  <div className=\"w-12 h-12 bg-[#111] rounded-full flex items-center justify-center border border-white/5 shrink-0\">\n                    <Hammer size={20} className=\"text-yellow-500/60\" />\n                  </div>\n                  <div>\n                    <h3 className=\"text-xl font-bold text-white\">GSD (GetShitDone)</h3>\n                    <div className=\"text-[11px] font-mono text-yellow-500/60 uppercase tracking-widest mt-1\">The Human Architect</div>\n                  </div>\n                </div>\n                \n                <p className=\"text-[14px] text-white/70 leading-[1.8]\">\n                  A meta-prompting tool that forces AI to plan before coding. It writes beautiful Markdown roadmaps and executes them pragmatically in the file system.\n                </p>\n                <div className=\"bg-[#111] border border-white/5 p-4 font-mono text-[12px] text-white/60 mt-auto\">\n                  <span className=\"text-yellow-500 font-bold\">Flaw:</span> Plans rely on text search (grep). It often misses hidden architectural dependencies.\n                </div>\n              </div>\n            </SectionReveal>\n\n            {/* Entire CLI */}\n            <SectionReveal>\n              <div className=\"bg-[#0A0A0A] border border-white/10 p-8 h-full flex flex-col gap-6\">\n                <div className=\"flex items-center gap-4 border-b border-white/10 pb-6\">\n                  <div className=\"w-12 h-12 bg-[#111] rounded-full flex items-center justify-center border border-white/5 shrink-0\">\n                    <History size={20} className=\"text-blue-500/60\" />\n                  </div>\n                  <div>\n                    <h3 className=\"text-xl font-bold text-white\">Entire CLI</h3>\n                    <div className=\"text-[11px] font-mono text-blue-500/60 uppercase tracking-widest mt-1\">The Session Bulldozer</div>\n                  </div>\n                </div>\n                \n                <p className=\"text-[14px] text-white/70 leading-[1.8]\">\n                  The ultimate \"Oops\" button. It rolls back your code and physically deletes the AI's chat log, giving the AI \"amnesia\" so it forgets its mistakes.\n                </p>\n                <div className=\"bg-[#111] border border-white/5 p-4 font-mono text-[12px] text-white/60 mt-auto\">\n                  <span className=\"text-blue-400 font-bold\">Flaw:</span> It deletes everything. You lose the good code alongside the bad code.\n                </div>\n              </div>\n            </SectionReveal>\n\n            {/* Aura View */}\n            <SectionReveal>\n              <div className=\"bg-[#111] border border-white/20 p-8 h-full flex flex-col gap-6 shadow-[0_0_50px_rgba(255,255,255,0.03)]\">\n                <div className=\"flex items-center gap-4 border-b border-white/10 pb-6\">\n                  <div className=\"w-12 h-12 bg-white/10 rounded-full flex items-center justify-center border border-white/20 shrink-0\">\n                    <Layers size={20} className=\"text-emerald-400\" />\n                  </div>\n                  <div>\n                    <h3 className=\"text-xl font-bold text-white\">Aura Core</h3>\n                    <div className=\"text-[11px] font-mono text-emerald-500/80 uppercase tracking-widest mt-1\">The Semantic Scalpel</div>\n                  </div>\n                </div>\n                \n                <p className=\"text-[14px] text-white/80 leading-[1.8]\">\n                  Aura parses your codebase into an Abstract Syntax Tree (Merkle-Graph). It mathematically verifies logic, blocks undocumented AI changes, and surgically rewinds functions.\n                </p>\n                <div className=\"bg-white/5 border-l-4 border-emerald-500/40 p-4 font-mono text-[12px] text-white mt-auto\">\n                  <span className=\"text-emerald-400 font-bold\">Advantage:</span> Retains the good code, surgically replaces the bad, and integrates GSD orchestration with AST vision.\n                </div>\n              </div>\n            </SectionReveal>\n          </div>\n        </section>\n\n        {/* Use Cases Matrix */}\n        <section className=\"py-32 px-8 md:px-16 lg:px-24 bg-[#050505] border-t border-white/10\">\n          <SectionReveal>\n            <div className=\"flex flex-col gap-4 mb-16\">\n              <h2 className=\"text-[32px] md:text-[48px] font-serif text-white\">\n                The Execution Matrix\n              </h2>\n              <p className=\"text-white/50 text-lg max-w-2xl\">\n                A pragmatic breakdown of when to deploy which tool across the AI engineering lifecycle.\n              </p>\n            </div>\n            \n            <div className=\"w-full overflow-x-auto pb-8\">\n              <div className=\"min-w-[800px] border border-white/10 bg-[#0A0A0A] rounded-xl overflow-hidden\">\n                {/* Header */}\n                <div className=\"grid grid-cols-4 border-b border-white/10 bg-[#111]\">\n                  <div className=\"p-6 font-mono text-[11px] uppercase tracking-[0.2em] text-white/40 flex items-center\">\n                    Engineering Objective\n                  </div>\n                  <div className=\"p-6 flex flex-col gap-2 border-l border-white/5\">\n                    <div className=\"flex items-center gap-2 text-yellow-500/80\">\n                      <Hammer size={16} />\n                      <span className=\"font-bold\">Standard GSD</span>\n                    </div>\n                    <span className=\"text-[12px] text-white/40\">The Human Architect</span>\n                  </div>\n                  <div className=\"p-6 flex flex-col gap-2 border-l border-white/5\">\n                    <div className=\"flex items-center gap-2 text-blue-500/80\">\n                      <History size={16} />\n                      <span className=\"font-bold\">Entire CLI</span>\n                    </div>\n                    <span className=\"text-[12px] text-white/40\">The Session Bulldozer</span>\n                  </div>\n                  <div className=\"p-6 flex flex-col gap-2 border-l border-white/5 bg-emerald-950/10\">\n                    <div className=\"flex items-center gap-2 text-emerald-400\">\n                      <Layers size={16} />\n                      <span className=\"font-bold\">Aura Core</span>\n                    </div>\n                    <span className=\"text-[12px] text-emerald-400/50\">The Semantic Scalpel</span>\n                  </div>\n                </div>\n\n                {/* Rows */}\n                {[\n                  {\n                    title: \"Building Net-New Features\",\n                    desc: \"Creating files, compiling, and running live tests.\",\n                    gsd: { status: \"best\", text: \"Best (Pragmatic & Fast)\", sub: \"Writes directly to filesystem\" },\n                    entire: { status: \"na\", text: \"N/A\", sub: \"Strictly a rollback tool\" },\n                    aura: { status: \"good\", text: \"Good (Strict & Verified)\", sub: \"Simulates logic, waits for agent\" }\n                  },\n                  {\n                    title: \"Hallucination Recovery\",\n                    desc: \"Fixing a mistake without poisoning the LLM prompt.\",\n                    gsd: { status: \"na\", text: \"N/A\", sub: \"Does not manage context\" },\n                    entire: { status: \"good\", text: \"Excellent (Full Wipe)\", sub: \"Deletes 15 mins of chat & code\" },\n                    aura: { status: \"best\", text: \"Ultimate (Amnesia Protocol)\", sub: \"Surgically reverts 1 function & overrides LLM memory\" }\n                  },\n                  {\n                    title: \"Security & Governance\",\n                    desc: \"Preventing untested or malicious code in production.\",\n                    gsd: { status: \"good\", text: \"Relies on manual tests\", sub: \"Prompt-based verification\" },\n                    entire: { status: \"na\", text: \"N/A\", sub: \"Blind to code execution\" },\n                    aura: { status: \"best\", text: \"Ultimate (Gatekeeper)\", sub: \"Math-blocks unapproved AST changes\" }\n                  },\n                  {\n                    title: \"Cross-Agent Handoff\",\n                    desc: \"Passing context from Gemini to Cursor without token bloat.\",\n                    gsd: { status: \"good\", text: \"Heavy\", sub: \"Raw Markdown files\" },\n                    entire: { status: \"good\", text: \"Heavy\", sub: \"Raw JSON transcripts\" },\n                    aura: { status: \"best\", text: \"Lightweight\", sub: \"Dense XML AST Logic Map\" }\n                  },\n                  {\n                    title: \"Language Support\",\n                    desc: \"Ability to parse and manage the stack.\",\n                    gsd: { status: \"best\", text: \"100% Agnostic\", sub: \"Works on all text files\" },\n                    entire: { status: \"best\", text: \"100% Agnostic\", sub: \"Works on all text files\" },\n                    aura: { status: \"good\", text: \"Targeted\", sub: \"Rust, Python, JS, TS only\" }\n                  }\n                ].map((row, idx) => (\n                  <div key={idx} className=\"grid grid-cols-4 border-b border-white/5 hover:bg-white/[0.02] transition-colors group\">\n                    <div className=\"p-6\">\n                      <div className=\"font-bold text-white mb-1\">{row.title}</div>\n                      <div className=\"text-[13px] text-white/40 leading-relaxed\">{row.desc}</div>\n                    </div>\n                    \n                    {[row.gsd, row.entire, row.aura].map((cell, colIdx) => (\n                      <div key={colIdx} className={`p-6 border-l border-white/5 flex flex-col justify-center ${colIdx === 2 ? 'bg-emerald-950/5 group-hover:bg-transparent' : ''}`}>\n                        <div className=\"flex items-center gap-2 mb-1\">\n                          {cell.status === 'best' && <Check size={16} className=\"text-emerald-400\" />}\n                          {cell.status === 'good' && <Check size={16} className=\"text-white/40\" />}\n                          {cell.status === 'na' && <Minus size={16} className=\"text-white/20\" />}\n                          <span className={`text-[14px] font-bold ${\n                            cell.status === 'best' ? 'text-white' : \n                            cell.status === 'good' ? 'text-white/70' : 'text-white/30'\n                          }`}>\n                            {cell.text}\n                          </span>\n                        </div>\n                        <div className=\"text-[12px] text-white/40 pl-6\">{cell.sub}</div>\n                      </div>\n                    ))}\n                  </div>\n                ))}\n              </div>\n            </div>\n            \n            <div className=\"mt-8 bg-gradient-to-r from-[#111] to-[#0A0A0A] border border-white/10 rounded-xl p-8 flex flex-col md:flex-row gap-8 items-center shadow-2xl\">\n              <div className=\"w-16 h-16 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shrink-0\">\n                <Layers className=\"text-white/60\" size={24} />\n              </div>\n              <div className=\"flex-1\">\n                <h4 className=\"text-white text-xl font-serif mb-3\">The Golden Rule</h4>\n                <p className=\"text-white/60 text-[16px] leading-relaxed\">\n                  Use <strong className=\"text-yellow-500/80 font-normal\">GSD</strong> when you want a Co-Founder you can argue with in plain English. Use <strong className=\"text-blue-500/80 font-normal\">Entire</strong> when you want a Ctrl+Z that never fails. Use <strong className=\"text-emerald-400 font-normal\">Aura</strong> when you have a Team of AIs that need to pass complex, mathematical code-state back and forth without human intervention.\n                </p>\n              </div>\n            </div>\n          </SectionReveal>\n        </section>\n\n        {/* Conclusion / Coexistence */}\n        <section className=\"py-32 px-8 md:px-16 lg:px-24\">\n          <SectionReveal>\n            <div className=\"w-full border-t border-white/20 pt-16 flex flex-col lg:flex-row gap-16 items-start\">\n               <div className=\"flex-1\">\n                 <h2 className=\"text-[32px] md:text-[48px] font-serif mb-8 leading-[1.1] tracking-tight text-[#F5F5F3]\">\n                   The Best of All Worlds.\n                 </h2>\n                 <p className=\"text-[18px] md:text-[20px] text-[#AAA] leading-[1.6] max-w-3xl\">\n                   We built Aura because we loved the UX of GSD and the safety of Entire, but we needed the mathematical rigor of an AST compiler. \n                 </p>\n                 <br />\n                 <p className=\"text-[18px] md:text-[20px] text-[#AAA] leading-[1.6] max-w-3xl\">\n                   Aura v0.2.0-alpha integrates the official GSD orchestration agents and the Amnesia memory-wipe protocols directly into a native Rust binary. You get the world's best planning and the world's safest rollbacks, all powered by an unbreakable Semantic Merkle-Graph.\n                 </p>\n               </div>\n            </div>\n          </SectionReveal>\n        </section>\n      </main>\n\n      <Footer />\n    </div>\n  );\n}","timestamp":1773405891075,"trigger":"pre_deletion_guard","agent_id":"Aura Deletion Guard"}