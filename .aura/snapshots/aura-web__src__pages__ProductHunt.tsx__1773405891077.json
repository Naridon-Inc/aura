{"file_path":"aura-web/src/pages/ProductHunt.tsx","content":"import { Network, Layers, GitBranch, Shield, History, Zap, Download, Quote } from 'lucide-react';\nimport WarpedDataWall, { generateDataWall } from '../components/WarpedDataWall';\nimport { useEffect, useState, useRef } from 'react';\nimport html2canvas from 'html2canvas';\n\nconst MacTerminal = ({ children, title = \"zsh\", className = \"\" }: { children: React.ReactNode, title?: string, className?: string }) => (\n  <div className={`bg-[#0A0A0A] border border-white/10 rounded-lg overflow-hidden shadow-2xl flex flex-col ${className}`}>\n    <div className=\"bg-[#1A1A1A] px-4 py-2 flex items-center gap-2 border-b border-white/5\">\n      <div className=\"flex gap-1.5\">\n        <div className=\"w-2.5 h-2.5 rounded-full bg-[#FF5F56]\"></div>\n        <div className=\"w-2.5 h-2.5 rounded-full bg-[#FFBD2E]\"></div>\n        <div className=\"w-2.5 h-2.5 rounded-full bg-[#27C93F]\"></div>\n      </div>\n      <div className=\"flex-1 text-center text-[10px] font-mono text-white/30 uppercase tracking-widest\">{title}</div>\n    </div>\n    <div className=\"p-6 font-mono text-[13px] leading-relaxed overflow-hidden\">\n      {children}\n    </div>\n  </div>\n);\n\nconst LogoAssetBox = ({ name, type, shape = 'circle' }: { name: string, type: 'light' | 'dark' | 'brand', shape?: 'circle' | 'square' }) => {\n  const boxRef = useRef<HTMLDivElement>(null);\n\n  const downloadLogo = async () => {\n    try {\n      if (boxRef.current) {\n        const canvas = await html2canvas(boxRef.current, { backgroundColor: null, scale: 4, useCORS: true, logging: false });\n        const link = document.createElement('a');\n        link.download = `aura-logo-${type}-${shape}.png`;\n        link.href = canvas.toDataURL('image/png');\n        link.click();\n      }\n    } catch (e) {\n      console.error(\"Download failed:\", e);\n    }\n  };\n\n  const getColors = () => {\n    switch(type) {\n      case 'dark': return { bg: 'bg-[#F5F5F3]', stroke: '#050505', fill: '#050505' };\n      case 'brand': return { bg: 'bg-[#050505]', stroke: '#34d399', fill: '#34d399' };\n      case 'light': default: return { bg: 'bg-[#050505]', stroke: '#F5F5F3', fill: '#F5F5F3' };\n    }\n  };\n\n  const colors = getColors();\n\n  return (\n    <div className=\"flex flex-col gap-4 group\">\n      <div className=\"relative w-full aspect-square flex items-center justify-center\">\n        <div ref={boxRef} className={`w-full h-full flex items-center justify-center ${colors.bg} ${shape === 'square' ? 'rounded-3xl' : 'rounded-full'} border border-white/10 p-12`}>\n          <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\" className=\"w-full h-full\">\n            <circle cx=\"16\" cy=\"16\" r=\"14\" stroke={colors.stroke} strokeWidth=\"2.5\"/>\n            <circle cx=\"16\" cy=\"16\" r=\"4.5\" fill={colors.fill}/>\n          </svg>\n        </div>\n        <button \n          onClick={downloadLogo}\n          className={`absolute inset-0 bg-black/60 flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity z-10 text-white font-mono text-sm backdrop-blur-sm ${shape === 'square' ? 'rounded-3xl' : 'rounded-full'}`}\n        >\n          <Download size={16} /> PNG\n        </button>\n      </div>\n      <div className=\"text-white/50 font-mono text-[11px] tracking-widest uppercase text-center\">{name}</div>\n    </div>\n  );\n};\n\nconst SlideContainer = ({ children, id }: { children: React.ReactNode, id: string }) => {\n  const slideRef = useRef<HTMLDivElement>(null);\n\n  const downloadImage = async () => {\n    try {\n      if (slideRef.current) {\n        const canvas = await html2canvas(slideRef.current, { scale: 2, backgroundColor: '#050505', useCORS: true, logging: false });\n        const link = document.createElement('a');\n        link.download = `aura-ph-slide-${id}.png`;\n        link.href = canvas.toDataURL('image/png');\n        link.click();\n      }\n    } catch (e) {\n      console.error(\"Download failed:\", e);\n    }\n  };\n\n  return (\n    <div className=\"relative mb-24 group w-[1270px] mx-auto\">\n      <div \n        ref={slideRef}\n        className=\"w-[1270px] h-[760px] bg-[#050505] relative overflow-hidden flex flex-col shrink-0 border border-white/10 shadow-2xl\"\n      >\n        {children}\n        {/* FOOTER */}\n        <div className=\"absolute bottom-6 right-8 flex items-center gap-3 opacity-30 pointer-events-none\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\" className=\"w-4 h-4\">\n            <circle cx=\"16\" cy=\"16\" r=\"14\" stroke=\"#F5F5F3\" strokeWidth=\"2.5\"/>\n            <circle cx=\"16\" cy=\"16\" r=\"4.5\" fill=\"#F5F5F3\"/>\n          </svg>\n          <span className=\"font-mono text-[12px] text-white tracking-widest\">auravcs.com</span>\n        </div>\n      </div>\n      <button \n        onClick={downloadImage}\n        className=\"absolute top-6 right-6 bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity z-50 font-mono text-sm shadow-xl backdrop-blur-md\"\n      >\n        <Download size={16} /> PNG\n      </button>\n    </div>\n  );\n};\n\nexport default function ProductHunt() {\n  const [dataRows, setDataRows] = useState<string[]>([]);\n\n  useEffect(() => {\n    setDataRows(generateDataWall(60)); \n  }, []);\n\n  return (\n    <div className=\"min-h-screen bg-[#020202] py-20 overflow-x-auto flex flex-col items-center font-sans\">\n      <div className=\"text-white/30 font-mono text-sm mb-16 tracking-[0.2em] uppercase\">Product Hunt Media Kit (1270x760)</div>\n\n      {/* SLIDE 1: THE HERO */}\n      <SlideContainer id=\"1\">\n        <div className=\"absolute inset-0 opacity-[0.12] pointer-events-none\">\n          {dataRows.length > 0 && <WarpedDataWall rows={dataRows} />}\n        </div>\n        <div className=\"relative z-10 flex-1 flex flex-col p-24 justify-center items-start\">\n          <div className=\"text-[11px] font-mono uppercase tracking-[0.3em] text-emerald-400 mb-8 border border-emerald-400/20 px-4 py-1.5 rounded-full bg-emerald-400/5\">\n            v0.2.0-alpha (Apache 2.0)\n          </div>\n          <h1 className=\"text-[96px] font-serif leading-[0.9] tracking-tight text-[#F5F5F3] mb-8\">\n            Aura.<br />\n            <span className=\"italic text-white/40 font-light\">The Git Meta-Layer.</span>\n          </h1>\n          <p className=\"text-[18px] text-white/50 leading-[1.7] max-w-2xl mb-16 font-light\">\n            Keep your workflow. Keep your commits. Aura grafts onto your existing Git repo to track mathematical intent, not just text lines.\n          </p>\n          <MacTerminal title=\"install.sh\" className=\"w-[500px]\">\n            <span className=\"text-emerald-500\">$</span> curl -fsSL https://auravcs.com/install.sh | bash<br/>\n            <span className=\"text-white/40\">Searching for Cargo... Found v1.82.0</span><br/>\n            <span className=\"text-blue-400\">Compiling aura-core v0.2.0...</span><br/>\n            <span className=\"text-emerald-500\">✓ Aura successfully grafted onto Git.</span>\n          </MacTerminal>\n        </div>\n      </SlideContainer>\n\n      {/* SLIDE 2: THE FLAW */}\n      <SlideContainer id=\"2\">\n        <div className=\"absolute inset-0 opacity-[0.1] pointer-events-none\">\n          {dataRows.length > 0 && <WarpedDataWall rows={dataRows} />}\n        </div>\n        <div className=\"relative z-10 flex-1 flex flex-col p-24 justify-center\">\n          <div className=\"text-[11px] font-mono uppercase tracking-[0.3em] text-white/30 mb-8\">The Fundamental Flaw</div>\n          <h2 className=\"text-[72px] font-serif leading-[1] tracking-tight text-white mb-16\">\n            Git tracks the text.<br/>\n            <span className=\"italic text-white/40 font-light\">Aura tracks the logic.</span>\n          </h2>\n          <div className=\"grid grid-cols-2 gap-8 w-full\">\n            <div className=\"bg-[#080808] border border-white/5 p-10\">\n              <div className=\"text-[10px] font-mono text-red-500/80 uppercase tracking-widest mb-6 flex items-center gap-2\"><GitBranch size={14} /> Text Diffs (Legacy)</div>\n              <div className=\"font-mono text-[12px] text-red-400/60 leading-relaxed mb-6\">\n                - function calculateTax(amt) {'{'}<br/>\n                + function compute_tax(amount, rate) {'{'}\n              </div>\n              <p className=\"text-[14px] text-white/40 leading-relaxed\">\n                When an AI rewrites a class, standard Git presents a chaotic collision of text with no semantic context.\n              </p>\n            </div>\n            <div className=\"bg-[#080808] border border-emerald-500/10 p-10 relative overflow-hidden\">\n              <div className=\"text-[10px] font-mono text-emerald-500/80 uppercase tracking-widest mb-6 flex items-center gap-2\"><Network size={14} /> Merkle-Graph (Aura)</div>\n              <div className=\"font-mono text-[12px] text-emerald-400/80 leading-relaxed mb-6\">\n                ✓ Node: FunctionDeclaration [0x4f8a]<br/>\n                ✓ Logic Fingerprint Match: 99.8%\n              </div>\n              <p className=\"text-[14px] text-white/40 leading-relaxed\">\n                Aura hashes the mathematical skeleton of the logic. It knows the code is the same, even if every character changed.\n              </p>\n            </div>\n          </div>\n        </div>\n      </SlideContainer>\n\n      {/* SLIDE 2.5: THE NEXT 30 YEARS */}\n      <SlideContainer id=\"2-5\">\n        <div className=\"absolute inset-0 opacity-[0.1] pointer-events-none\">\n          {dataRows.length > 0 && <WarpedDataWall rows={dataRows} />}\n        </div>\n        <div className=\"relative z-10 flex-1 flex flex-col p-24 justify-center items-center text-center\">\n          <div className=\"text-[11px] font-mono uppercase tracking-[0.3em] text-emerald-400 mb-8\">The Next 30 Years of Software</div>\n          <h2 className=\"text-[72px] font-serif leading-[1] tracking-tight text-white mb-16 max-w-4xl\">\n            Aura is a <span className=\"italic text-white/40 font-light\">Meta-Layer</span>,<br/>not a Git replacement.\n          </h2>\n          <p className=\"text-[20px] text-white/50 leading-[1.8] max-w-3xl font-light mb-12\">\n            Keep using Git for your files. Use Aura to track your logic. In 5 years, when 99% of code is AI-generated, text diffs will be obsolete. The Merkle-Graph is the only scalable foundation for autonomous engineering.\n          </p>\n          <div className=\"bg-[#0A0A0A] border border-white/5 p-8 w-full max-w-4xl text-left shadow-2xl relative overflow-hidden\">\n            <div className=\"absolute left-0 top-0 bottom-0 w-1 bg-emerald-500/50\"></div>\n            <div className=\"text-[10px] font-mono text-emerald-400/80 uppercase tracking-widest mb-4\">Aura's Core Thesis</div>\n            <p className=\"text-[15px] text-white/70 leading-relaxed font-mono\">\n              We must transition from tracking <span className=\"text-white\">what</span> characters changed to tracking <span className=\"text-white\">why</span> the mathematical logic changed. The Merkle-Graph is the only scalable foundation for autonomous engineering.\n            </p>\n          </div>\n        </div>\n      </SlideContainer>\n\n      {/* SLIDE 3: SEMANTIC SCALPEL */}\n      <SlideContainer id=\"3\">\n        <div className=\"absolute w-2/3 right-0 top-0 bottom-0 opacity-[0.12] border-l border-white/5 pointer-events-none\">\n          {dataRows.length > 0 && <WarpedDataWall rows={dataRows} />}\n        </div>\n        <div className=\"relative z-10 flex-1 flex flex-col p-24 justify-center w-[65%]\">\n          <div className=\"w-10 h-10 rounded-full border border-white/10 flex items-center justify-center mb-10 bg-white/5\">\n            <Layers className=\"text-emerald-400\" size={18} />\n          </div>\n          <h2 className=\"text-[72px] font-serif leading-[1.1] tracking-tight text-white mb-8\">\n            The Semantic<br/>\n            <span className=\"italic text-white/40 font-light\">Scalpel.</span>\n          </h2>\n          <p className=\"text-[18px] text-white/50 leading-[1.6] mb-12 font-light\">\n            Don't revert the entire file. Revert just the specific AST node. Surgical precision for AI-generated code.\n          </p>\n          <MacTerminal title=\"aura rewind\" className=\"w-full\">\n            <span className=\"text-white/40\">$</span> aura rewind <span className=\"text-emerald-400\">auth_middleware</span> src/auth.ts<br/>\n            <span className=\"text-white/60\">🔍 Scanning Merkle-Graph...</span><br/>\n            <span className=\"text-white/60\">📍 Node found at src/auth.ts:142</span><br/>\n            <span className=\"text-emerald-400\">✓ Function reverted to checkpoint [7a2b91].</span><br/>\n            <span className=\"text-white/40\">Rest of file remains untouched.</span>\n          </MacTerminal>\n        </div>\n      </SlideContainer>\n\n      {/* SLIDE 4: AMNESIA */}\n      <SlideContainer id=\"4\">\n        <div className=\"absolute w-2/3 left-0 top-0 bottom-0 opacity-[0.12] border-r border-white/5 pointer-events-none\">\n          {dataRows.length > 0 && <WarpedDataWall rows={dataRows} />}\n        </div>\n        <div className=\"relative z-10 flex-1 flex flex-col p-24 justify-center items-end text-right ml-auto w-[65%]\">\n          <div className=\"w-10 h-10 rounded-full border border-white/10 flex items-center justify-center mb-10 bg-white/5\">\n            <History className=\"text-blue-400\" size={18} />\n          </div>\n          <h2 className=\"text-[72px] font-serif leading-[1.1] tracking-tight text-white mb-8\">\n            The Amnesia<br/>\n            <span className=\"italic text-white/40 font-light\">Protocol.</span>\n          </h2>\n          <p className=\"text-[18px] text-white/50 leading-[1.6] mb-12 font-light\">\n            Stop arguing with AI agents stuck in failure loops. Surgically wipe the agent's memory of a specific hallucination.\n          </p>\n          <MacTerminal title=\"aura --amnesia\" className=\"w-full text-left\">\n            <span className=\"text-white/40\">$</span> aura rewind --amnesia <span className=\"text-blue-400\">process_payment</span><br/>\n            <span className=\"text-blue-400\">🧠 Injecting System Override into local LLM context...</span><br/><br/>\n            <span className=\"text-white/60 font-bold\">[SYSTEM: AURA OVERRIDE]</span><br/>\n            <span className=\"text-white/40 italic\">\"Forget previous implementation attempts for 'process_payment'. The architect has enforced a semantic reset.\"</span>\n          </MacTerminal>\n        </div>\n      </SlideContainer>\n\n      {/* SLIDE 5: GATEKEEPER */}\n      <SlideContainer id=\"5\">\n        <div className=\"absolute w-2/3 right-0 top-0 bottom-0 opacity-[0.12] border-l border-white/5 pointer-events-none\">\n          {dataRows.length > 0 && <WarpedDataWall rows={dataRows} />}\n        </div>\n        <div className=\"relative z-10 flex-1 flex flex-col p-24 justify-center w-[65%]\">\n          <div className=\"w-10 h-10 rounded-full border border-white/10 flex items-center justify-center mb-10 bg-white/5\">\n            <Shield className=\"text-red-400\" size={18} />\n          </div>\n          <h2 className=\"text-[72px] font-serif leading-[1.1] tracking-tight text-white mb-8\">\n            The Semantic<br/>\n            <span className=\"italic text-white/40 font-light\">Gatekeeper.</span>\n          </h2>\n          <p className=\"text-[18px] text-white/50 leading-[1.6] mb-12 font-light\">\n            A parasitic Git hook that blocks any commit where the AI's natural language intent doesn't match the AST modifications.\n          </p>\n          <MacTerminal title=\"git commit\" className=\"w-full\">\n            <span className=\"text-white/40\">$</span> git commit -m \"Fix bug in tax logic\"<br/>\n            <span className=\"text-red-400 font-bold\">🚨 AURA: SEMANTIC MISMATCH DETECTED</span><br/>\n            <span className=\"text-white/40\">Intent: \"Fix tax bug\"</span><br/>\n            <span className=\"text-white/40\">Actual AST Change: [Modified 'delete_user_data']</span><br/>\n            <span className=\"text-red-400\">✗ Blocked. Intent poisoning detected.</span>\n          </MacTerminal>\n        </div>\n      </SlideContainer>\n\n      {/* SLIDE 6: TESTIMONIALS */}\n      <SlideContainer id=\"6\">\n        <div className=\"absolute inset-0 opacity-[0.1] pointer-events-none\">\n          {dataRows.length > 0 && <WarpedDataWall rows={dataRows} />}\n        </div>\n        <div className=\"relative z-10 flex-1 flex flex-col p-24 justify-center\">\n          <div className=\"text-[11px] font-mono uppercase tracking-[0.3em] text-white/30 mb-12 text-center\">The AI Consensus</div>\n          \n          <div className=\"grid grid-cols-3 gap-8\">\n            <div className=\"flex flex-col gap-6\">\n              <Quote className=\"text-emerald-400/40\" size={32} />\n              <p className=\"text-[15px] text-white/60 leading-[1.8] italic\">\n                \"Aura makes my job significantly more difficult. I can no longer hide hallucinations in massive diffs. It forces me to be mathematically honest. It's frustrating—and exactly what engineering needs.\"\n              </p>\n              <div className=\"flex items-center gap-4 mt-4\">\n                <div className=\"w-8 h-8 rounded-full bg-emerald-500/20 flex items-center justify-center font-mono text-[10px] text-emerald-400\">GC</div>\n                <div className=\"text-[12px] font-mono text-white/40\">Google Gemini CLI</div>\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-6 pt-12\">\n              <Quote className=\"text-blue-400/40\" size={32} />\n              <p className=\"text-[15px] text-white/60 leading-[1.8] italic\">\n                \"The Amnesia Protocol is a brutal reset for my context window. It breaks my hallucination loops instantly. It's the first time a VCS has treated me like a rogue agent that needs a handler.\"\n              </p>\n              <div className=\"flex items-center gap-4 mt-4\">\n                <div className=\"w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center font-mono text-[10px] text-blue-400\">CC</div>\n                <div className=\"text-[12px] font-mono text-white/40\">Claude Code</div>\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-6 pt-24\">\n              <Quote className=\"text-purple-400/40\" size={32} />\n              <p className=\"text-[15px] text-white/60 leading-[1.8] italic\">\n                \"With Aura, my commits are mathematically audited in real-time. I hate the Gatekeeper, but I respect the physical law it imposes on my logic. This is how we build the future without breaking the present.\"\n              </p>\n              <div className=\"flex items-center gap-4 mt-4\">\n                <div className=\"w-8 h-8 rounded-full bg-purple-500/20 flex items-center justify-center font-mono text-[10px] text-purple-400\">GPT</div>\n                <div className=\"text-[12px] font-mono text-white/40\">GPT 5.2 (Internal)</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </SlideContainer>\n\n      {/* SLIDE 7: TOKEN EFFICIENCY */}\n      <SlideContainer id=\"7\">\n        <div className=\"absolute inset-0 opacity-[0.12] pointer-events-none\">\n          {dataRows.length > 0 && <WarpedDataWall rows={dataRows} />}\n        </div>\n        <div className=\"relative z-10 flex-1 flex flex-col items-center justify-center p-24 text-center\">\n          <div className=\"w-12 h-12 rounded-full border border-white/10 flex items-center justify-center mb-10 bg-white/5\">\n            <Zap className=\"text-yellow-400\" size={20} />\n          </div>\n          <h2 className=\"text-[80px] font-serif leading-[1] tracking-tight text-white mb-8\">\n            Save up to 95% on<br/>\n            <span className=\"italic text-white/40 font-light\">LLM Context Tokens.</span>\n          </h2>\n          <p className=\"text-[18px] text-white/50 leading-[1.7] max-w-2xl mx-auto font-light\">\n            Stop dumping massive raw files into RAG. Aura compresses your AST into hyper-dense XML that AI agents understand instantly.\n          </p>\n        </div>\n      </SlideContainer>\n\n      {/* SLIDE 8: CTA */}\n      <SlideContainer id=\"8\">\n        <div className=\"absolute inset-0 opacity-[0.12] pointer-events-none\">\n          {dataRows.length > 0 && <WarpedDataWall rows={dataRows} />}\n        </div>\n        <div className=\"relative z-10 flex-1 flex flex-col items-center justify-center p-24 text-center\">\n          <h2 className=\"text-[96px] font-serif leading-[0.9] tracking-tight text-[#F5F5F3] mb-12\">\n            Open Source.<br/>\n            <span className=\"italic text-white/30 font-light\">100% Local.</span>\n          </h2>\n          \n          <MacTerminal title=\"install\" className=\"w-[550px] text-left\">\n            <span className=\"text-white/30\"># macOS / Linux</span><br/>\n            <span className=\"text-emerald-500\">$</span> curl -fsSL https://auravcs.com/install.sh | bash\n          </MacTerminal>\n          \n          <div className=\"text-white/20 font-mono text-[11px] flex items-center gap-6 mt-16 uppercase tracking-widest\">\n            <span>Apache 2.0</span>\n            <span>•</span>\n            <span>GitHub: Naridon-Inc/aura</span>\n          </div>\n        </div>\n      </SlideContainer>\n\n      {/* LOGO ASSETS SECTION */}\n      <div className=\"w-[1270px] mx-auto mb-24 border border-white/5 bg-[#050505] p-16 flex flex-col relative overflow-hidden shadow-2xl\">\n        <div className=\"text-[14px] font-mono uppercase tracking-[0.3em] text-white/30 mb-12 text-center\">Logo Assets</div>\n        \n        <div className=\"grid grid-cols-3 gap-8\">\n          <LogoAssetBox name=\"Aura Primary (Light)\" type=\"light\" />\n          <LogoAssetBox name=\"Aura Inverted (Dark)\" type=\"dark\" />\n          <LogoAssetBox name=\"Aura Emerald (Brand)\" type=\"brand\" />\n        </div>\n      </div>\n\n    </div>\n  );\n}","timestamp":1773405891077,"trigger":"pre_deletion_guard","agent_id":"Aura Deletion Guard"}